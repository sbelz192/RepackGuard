<?xml version="1.0" encoding="utf-8"?>
<!-- Lokale NuGet-Konfiguration fuer RepackGuard.
     Die Benutzer-weitige Config nutzt PackageSourceMapping, das die
     Self-Contained-Runtime-Pakete blockiert. Hier: eine klare Quelle. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
